# cPanel / production settings
PORT=4000
# Use the exact frontend/domain origin. Example: https://cms.example.com
CORS_ORIGIN=https://your-domain.com
MAX_BODY_SIZE=1mb
# Set this only when initializing/updating the owner account.
# Never commit the real password to the repository.
INIT_ADMIN_PASSWORD=change-me-before-running-init-db
